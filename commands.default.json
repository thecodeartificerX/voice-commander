{
  "schema_version": 1,
  "graphs": {
    "reopen_tab": {
      "schema_version": 1,
      "name": "reopen_tab",
      "kind": "command",
      "description": "Reopen the most recently closed tab",
      "synonyms": [
        "reopen tab",
        "restore tab",
        "undo close tab"
      ],
      "inputs": [],
      "llm_visible": true,
      "strict": true,
      "enabled": true,
      "timeout_ms": 5000,
      "foreach_iteration_cap": 50,
      "nodes": [
        {
          "id": "n1",
          "ref": "pipeline.press",
          "kwargs": {
            "combo": "ctrl+shift+t"
          },
          "pos": [
            80,
            120
          ]
        }
      ],
      "edges": []
    },
