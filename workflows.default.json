{
  "schema_version": 1,
  "graphs": {
    "search_web": {
      "schema_version": 1,
      "name": "search_web",
      "kind": "workflow",
      "description": "Focus the default browser and search for a query",
      "synonyms": [
        "search",
        "search web for",
        "google",
        "look up"
      ],
      "inputs": [
        {
          "name": "query",
          "type": "str",
          "required": true,
          "description": "What to search for"
        }
      ],
      "llm_visible": true,
      "strict": true,
      "enabled": true,
      "timeout_ms": 10000,
      "foreach_iteration_cap": 50,
      "nodes": [
        {
          "id": "input_node",
          "ref": "value.input",
          "kwargs": {},
          "pos": [
            0,
            120
          ]
        },
        {
          "id": "n1",
          "ref": "pipeline.focus",
          "kwargs": {
            "target": "{default_browser}"
          },
          "pos": [
            80,
            120
          ]
        },
        {
          "id": "n2",
          "ref": "pipeline.press",
          "kwargs": {
            "combo": "ctrl+t"
          },
          "pos": [
            280,
            120
          ]
        },
        {
          "id": "n3",
          "ref": "pipeline.press",
          "kwargs": {
            "combo": "ctrl+l"
          },
          "pos": [
            480,
            120
          ]
        },
        {
          "id": "n4",
          "ref": "pipeline.type",
          "kwargs": {
            "text": ""
          },
          "pos": [
            680,
            120
          ]
        },
        {
          "id": "n5",
          "ref": "pipeline.press",
          "kwargs": {
            "combo": "enter"
          },
          "pos": [
            880,
            120
          ]
        }
      ],
      "edges": [
        {
          "from": "n1.ok",
          "to": "n2.in"
        },
        {
          "from": "n2.ok",
          "to": "n3.in"
        },
        {
          "from": "input_node.query",
          "to": "n4.text"
        },
        {
          "from": "n3.ok",
          "to": "n4.in"
        },
        {
          "from": "n4.ok",
          "to": "n5.in"
        }
      ]
    }
  }
}
