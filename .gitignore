# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# uv
# uv.lock is committed

# Project artefacts
outputs/*
!outputs/.gitkeep
*.log
voice-commander.log

# User-owned command + workflow catalogs — seeded from *.default.json on first
# run. Not tracked so fresh clones regenerate them cleanly and local edits
# don't leak into commits.
commands.json
workflows.json
commands.json.lock
workflows.json.lock
*.json.bak

# Archon — track workflow + command definitions (project tooling); ignore
# only runtime artefacts and any MCP server configs that may carry secrets.
# See .archon/config.yaml for worktree.copyFiles entries.
.archon/mcp/
.archon/runs/
.archon/state/
.archon/cache/

# start.ps1 last-choice persistence
.last-router-mode

# Claude Code ephemeral state
.claude/scheduled_tasks.lock

# Purchased sprite asset packs — not redistributable; keep local only.
# charsheet.png is the single file extracted + shipped for the sprite to run.
assets/sprite/CatPackFree/
assets/sprite/CatPackPaid/
assets/sprite/CatRoomPaid/
assets/sprite/Gemini_Generated_Image_*.png

# Superpowers brainstorming mockups + session state
.superpowers/

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
Desktop.ini

# Observability SQLite store (ADR 0070)
outputs/runs.db
outputs/runs.db-wal
outputs/runs.db-shm
outputs/runs.db.corrupt-*

# Builder React SPA build output (ADR 0071) — never commit built artifacts
src/voice_commander/web/static/builder/

# Archon git worktrees (parallel agent workspaces)
pi-worktrees/
